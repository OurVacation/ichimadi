# 서버(~/ichimadi/.env)에 둘 배포용 환경변수. 실제 값은 절대 커밋하지 않는다.
# 설명: docs/INFRA.md "서버 .env"

# 사이트 주소 (화면과 API가 같이 쓴다)
SITE_ADDRESS=34-47-91-94.sslip.io

# DB. DATABASE_URL 은 compose.prod.yml 이 아래 값으로 만들어서 api 에 넘긴다.
POSTGRES_DB=ichimadi
POSTGRES_USER=ichimadi
# 무작위 값으로 바꾼다. 예) openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# 백엔드 (backend/app/core/config.py)
APP_ENV=prod
# 무작위 긴 값으로 바꾼다. 예) openssl rand -hex 32  (기본 개발 키는 prod 에서 시작이 거부된다)
JWT_SECRET=change-me-to-a-long-random-string
# 같은 주소에서 호출하므로 사실상 필요 없지만, 명시해 둔다
CORS_ORIGINS=["https://34-47-91-94.sslip.io"]
# 비워 두면 이름 추천 API 가 503 name_suggest_unavailable 을 돌려준다 (FE 는 임시 이름 생성기로 대체)
GEMINI_API_KEY=
# GEMINI_MODEL 을 지정하지 않으면 config.py 의 기본값을 쓴다
# GEMINI_MODEL=

# 서버에서 직접 docker compose 를 실행할 때 쓸 이미지 위치 (CD 는 자기 값을 넘긴다)
IMAGE_PREFIX=ghcr.io/ourvacation
