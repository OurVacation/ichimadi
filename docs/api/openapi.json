    "/api/phrase-sets": {
      "get": {
        "tags": [
          "phrases"
        ],
        "summary": "한마디 카테고리 목록",
        "operationId": "get_phrase_sets_api_phrase_sets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
