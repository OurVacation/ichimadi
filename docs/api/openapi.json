{
  "openapi": "3.1.0",
  "info": {
    "title": "ichimadi",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "서버 상태 확인",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message_ja": {
            "type": "string",
            "title": "Message Ja"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message_ja"
        ],
        "title": "ErrorResponse",
        "examples": [
          {
            "code": "validation_error",
            "message_ja": "入力内容を確認してください。"
          }
        ]
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "examples": [
          {
            "status": "ok"
          }
        ]
      }
    }
  }
}
