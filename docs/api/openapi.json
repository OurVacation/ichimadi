    "/api/phrases": {
      "get": {
        "tags": [
          "phrases"
        ],
        "summary": "한마디 목록",
        "operationId": "get_phrases_api_phrases_get",
        "parameters": [
          {
            "name": "set_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Set Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
