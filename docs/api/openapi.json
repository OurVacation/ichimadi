{
  "openapi": "3.1.0",
  "info": {
    "title": "ichimadi",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "서버 상태 확인",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "로그인",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "내 정보",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/me/profile": {
      "put": {
        "tags": [
          "me"
        ],
        "summary": "도장 프로필 저장",
        "operationId": "save_profile_api_me_profile_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Animal": {
        "type": "string",
        "enum": [
          "tiger",
          "rabbit",
          "magpie",
          "bear"
        ],
        "title": "Animal"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message_ja": {
            "type": "string",
            "title": "Message Ja"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message_ja"
        ],
        "title": "ErrorResponse",
        "examples": [
          {
            "code": "validation_error",
            "message_ja": "入力内容を確認してください。"
          }
        ]
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "examples": [
          {
            "status": "ok"
          }
        ]
      },
      "LoginRequest": {
        "properties": {
          "login_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Login Id"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "login_id",
          "password"
        ],
        "title": "LoginRequest",
        "examples": [
          {
            "login_id": "judge01",
            "password": "4821"
          }
        ]
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "account_id",
          "expires_in"
        ],
        "title": "LoginResponse",
        "examples": [
          {
            "access_token": "eyJ...",
            "account_id": "judge01",
            "expires_in": 259200,
            "token_type": "bearer"
          }
        ]
      },
      "MeResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "animal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Animal"
              },
              {
                "type": "null"
              }
            ]
          },
          "korean_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Korean Name"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "animal",
          "korean_name"
        ],
        "title": "MeResponse",
        "examples": [
          {
            "account_id": "judge01"
          }
        ]
      },
      "ProfileRequest": {
        "properties": {
          "animal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Animal"
          },
          "korean_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Korean Name"
          }
        },
        "type": "object",
        "required": [
          "animal",
          "korean_name"
        ],
        "title": "ProfileRequest",
        "examples": [
          {
            "animal": "tiger",
            "korean_name": "양자"
          },
          {
            "animal": "tiger",
            "korean_name": ""
          }
        ]
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
