APP_NAME=ichimadi
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://ichimadi:ichimadi@db:5432/ichimadi
APP_ENV=local
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_HOURS=72
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# thinking 정도: minimal | low | medium | high | (빈 값 = 모델 기본값). 3.8-flash 는 low 부터
GEMINI_THINKING_LEVEL=low
# Gemini SDK HTTP 제한 시간(초). API 최소값이 10초라 더 작게 줘도 10초로 올린다
NAME_SUGGEST_TIMEOUT_SECONDS=10
# CONTENT_DIR=/content
